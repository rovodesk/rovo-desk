{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Hono",
  "compilerOptions": {
    "composite": true,
    "target": "esnext",
    "module": "nodenext",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ESNext"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "types": ["@cloudflare/workers-types"],
    "paths": {
      "@zero-heads-lab/*": ["../../packages/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
