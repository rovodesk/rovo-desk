{
  "extends": "@zero-heads-lab/typescript-config/react-library.json",
  "compilerOptions": {
    "lib": ["ES2015"],
    "module": "es2015",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "baseUrl": "./lib",
    "strictNullChecks": true,
    "paths": {
      "@zero-heads-lab/*": ["../../packages/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
