{
  "name": "@zero-heads-lab/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./lib/index.ts",
  "module": "./lib/index.ts",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": "./lib/index.ts",
    "./schemas": "./lib/schemas/index.ts"
  },
  "scripts": {
    "build": "drizzle-kit generate --config drizzle.config.ts",
    "migrate": "npm run build && bunx drizzle-kit migrate --config drizzle.config.ts",
    "push": "drizzle-kit push --config drizzle.config.ts",
    "pull": "drizzle-kit pull --config drizzle.config.ts",
    "check": "drizzle-kit check --config drizzle.config.ts",
    "snapshot": "drizzle-kit up --config drizzle.config.ts",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "test": "vitest run"
  },
  "dependencies": {
    "@t3-oss/env-core": "catalog:",
    "@zero-heads-lab/testing": "workspace:*",
    "@zero-heads-lab/observability": "workspace:*",
    "drizzle-orm": "catalog:drizzle",
    "postgres": "^3.4.8",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "catalog:react19",
    "@zero-heads-lab/typescript-config": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-kit": "catalog:drizzle",
    "drizzle-seed": "catalog:drizzle",
    "testcontainers": "catalog:testing",
    "vitest": "catalog:testing"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  }
}
