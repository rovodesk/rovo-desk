{
  "configurations": [
    {
      "name": "auth-service",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/backend/auth-service/node_modules/wrangler/bin/wrangler.js",
      "args": ["dev", "--env", "staging"],
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "action": "debugWithChrome",
        "killOnServerStop": true,
        "pattern": "Local:.+(https?://.+)",
        "uriFormat": "%s",
        "webRoot": "${workspaceFolder}/backend/auth-service"
      },
      "cwd": "${workspaceFolder}/backend/auth-service",
      "console": "integratedTerminal"
    }
  ]
}
