{
  "extends": "@zero-heads-lab/typescript-config/vite.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@zero-heads-lab/*": ["../../packages/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../packages/design-system/layout/main-content.tsx",
    "../../packages/design-system/layout/header.tsx",
    "../../packages/design-system/layout/app-title.tsx"
  ],
  "exclude": ["node_modules", "dist"]
}
