{
  "extends": "@zero-heads-lab/typescript-config/vite.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@zero-heads-lab/*": ["../../packages/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../packages/billing/components/billing-history-table.tsx",
    "../../packages/billing/components/payment-method.tsx",
    "../../packages/billing/components/subscription-overview.tsx"
  ],
  "exclude": ["node_modules", "dist"]
}
