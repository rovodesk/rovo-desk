{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "dev": {
    "port": 5001
  },
  "env": {
    "production": {
      "observability": {
        "traces": {
          "enabled": true,
          "head_sampling_rate": 0.05
        },
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1
        }
      },
      "kv_namespaces": [
        {
          "binding": "CACHE_STORE",
          "id": "8a6df503452b475ebae5b581ca2d746a"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "KNOWLEDGE_BASE",
            "class_name": "Document"
          },
          {
            "name": "CHAT_ROOM",
            "class_name": "ChatRoom"
          }
        ],
      }
    },
    "staging": {
      "observability": {
        "traces": {
          "enabled": true,
        },
        "logs": {
          "enabled": true,
        }
      },
      "kv_namespaces": [
        {
          "binding": "CACHE_STORE",
          "id": "76498561a52c431b908703a12bacfc47"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "KNOWLEDGE_BASE",
            "class_name": "Document"
          },
          {
            "name": "CHAT_ROOM",
            "class_name": "ChatRoom"
          }
        ],
      }
    }
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": [
        "Document"
      ]
    },
    {
      "tag": "v2",
      "new_classes": [
        "ChatRoom"
      ]
    }
  ]
}