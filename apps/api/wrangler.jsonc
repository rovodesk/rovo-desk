{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "dev": {
    "port": 5001
  },
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:3001, http://localhost:3002, http://localhost:3003,http://localhost:3005, http://127.0.0.1:3001, http://127.0.0.1:3002, http://127.0.0.1:3003, http://127.0.0.1:3005",
  },
  "kv_namespaces": [
    {
      "binding": "CACHE_STORE",
      "id": "0173a3d4931d4ddaa5f140fda68639bc"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "KNOWLEDGE_BASE",
        "class_name": "Document"
      },
      {
        "name": "CHAT_ROOM",
        "class_name": "ChatRoom"
      }
    ],
  },
  "migrations": [
      {
        "tag": "v1",
        "new_classes": [
          "Document"
        ]
      },
      {
      "tag": "v1",
      "new_classes": [
        "ChatRoom"
      ]
    }
    ]
}