{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "dev": {
    "port": 5001
  },
  "kv_namespaces": [
    {
      "binding": "AUTH_CACHE",
      "id": "0173a3d4931d4ddaa5f140fda68639bc"
    },
    {
      "binding": "SDK_CACHE",
      "id": "691f41ea481c46388e17acc6bd89fdb9"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "KNOWLEDGE_BASE",
        "class_name": "Document"
      },
      {
        "name": "CHAT_ROOM",
        "class_name": "ChatRoom"
      }
    ],
  },
  "migrations": [
      {
        "tag": "v1",
        "new_classes": [
          "Document"
        ]
      },
      {
      "tag": "v1",
      "new_classes": [
        "ChatRoom"
      ]
    }
    ]
}