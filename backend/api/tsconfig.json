{
  "extends": "@zero-heads-lab/typescript-config/encore.json",
  "compilerOptions": {
    "baseUrl": ".",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["./*"],
      "~encore/*": ["./encore.gen/*"],
      "encore/client": ["./client.ts"],
      "@zero-heads-lab/observability": [
        "../../packages/observability/lib/index.ts"
      ],
      "@zero-heads-lab/shared": ["../../packages/shared/lib/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "test"]
}
