{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "src/app/index.ts",
  "compatibility_date": "2026-02-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "dev": {
    "port": 5001
  },
  "env": {
    "production": {
      "observability": {
        "traces": {
          "enabled": true,
          "head_sampling_rate": 0.05
        },
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1
        }
      },
      "kv_namespaces": [
        {
          "binding": "CACHE_STORE",
          "id": "8a6df503452b475ebae5b581ca2d746a"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "KNOWLEDGE_BASE",
            "class_name": "Document"
          },
          {
            "name": "CHAT_ROOM",
            "class_name": "ChatRoom"
          }
        ],
      },
      "queues": {
        "producers": [
          {
            "binding": "EMAIL_QUEUE",
            "queue": "7ecf8added424d82bbd035230e7b5e90"
          }
        ],
        "consumers": [
          {
            "queue": "7ecf8added424d82bbd035230e7b5e90",
            "max_batch_size": 10,
            "dead_letter_queue": "my-queue-dlq"
          }
        ]
      },
      "secrets_store_secrets": [
        {
          "binding": "POSTHOG_API_KEY",
          "secret_name": "POSTHOG_API_KEY",
          "store_id": "cc511ff952de49388a462b443f4995ac"
        },
        {
          "binding": "DATABASE_URL",
          "secret_name": "DATABASE_URL",
          "store_id": "cc511ff952de49388a462b443f4995ac"
        },
        {
          "binding": "BETTER_AUTH_SECRET",
          "secret_name": "BETTER_AUTH_SECRET",
          "store_id": "cc511ff952de49388a462b443f4995ac"
        },
        {
          "binding": "GOOGLE_CLIENT_ID",
          "secret_name": "GOOGLE_CLIENT_ID",
          "store_id": "cc511ff952de49388a462b443f4995ac"
        },
        {
          "binding": "GOOGLE_CLIENT_SECRET",
          "secret_name": "GOOGLE_CLIENT_SECRET",
          "store_id": "cc511ff952de49388a462b443f4995ac"
        },
        {
          "binding": "GITHUB_CLIENT_ID",
          "secret_name": "GITHUB_CLIENT_ID",
          "store_id": "cc511ff952de49388a462b443f4995ac"
        },
        {
          "binding": "GITHUB_CLIENT_SECRET",
          "secret_name": "GITHUB_CLIENT_SECRET",
          "store_id": "cc511ff952de49388a462b443f4995ac"
        },
        {
          "binding": "AWS_COGNITO_CLIENT_ID",
          "secret_name": "AWS_COGNITO_CLIENT_ID",
          "store_id": "cc511ff952de49388a462b443f4995ac"
        },
        {
          "binding": "AWS_COGNITO_CLIENT_SECRET",
          "secret_name": "AWS_COGNITO_CLIENT_SECRET",
          "store_id": "cc511ff952de49388a462b443f4995ac"
        },
        {
          "binding": "AWS_COGNITO_DOMAIN",
          "secret_name": "AWS_COGNITO_DOMAIN",
          "store_id": "cc511ff952de49388a462b443f4995ac"
        },
        {
          "binding": "AWS_COGNITO_USER_POOL_ID",
          "secret_name": "AWS_COGNITO_USER_POOL_ID",
          "store_id": "cc511ff952de49388a462b443f4995ac"
        }
      ],
      "vars": {
        "POSTHOG_HOST": "https://us.i.posthog.com",
        "BETTER_AUTH_BASE_PATH": "/auth",
        // "END_USER_DASHBOARD_URL": "http://localhost:3002",
        // "ALLOWED_ORIGINS": "http://localhost:3000,http://localhost:3002,http://localhost:3005",
        "AWS_REGION": "ap-south-1",
        "LOG_LEVEL": "error",
        "ANALYTICS_ENABLED": "true"
      }
    },
    "staging": {
      "observability": {
        "traces": {
          "enabled": true,
        },
        "logs": {
          "enabled": true,
        }
      },
      "kv_namespaces": [
        {
          "binding": "CACHE_STORE",
          "id": "76498561a52c431b908703a12bacfc47"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "EMAIL_QUEUE",
            "queue": "7ecf8added424d82bbd035230e7b5e90"
          }
        ],
        "consumers": [
          {
            "queue": "7ecf8added424d82bbd035230e7b5e90",
            "max_batch_size": 10,
            "dead_letter_queue": "email-queue-dlq"
          }
        ]
      },
      "secrets": {
        "required": ["POSTHOG_API_KEY", "DATABASE_URL", "BETTER_AUTH_SECRET", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "GITHUB_CLIENT_ID", "GITHUB_CLIENT_SECRET", "AWS_COGNITO_CLIENT_ID", "AWS_COGNITO_CLIENT_SECRET", "AWS_COGNITO_DOMAIN", "AWS_COGNITO_USER_POOL_ID"]
      },
      "vars": {
        "POSTHOG_HOST": "https://us.i.posthog.com",
        "BETTER_AUTH_BASE_PATH": "/auth",
        "END_USER_DASHBOARD_URL": "http://localhost:3002",
        "ALLOWED_ORIGINS": "http://localhost:3000,http://localhost:3002,http://localhost:3005",
        "AWS_REGION": "ap-south-1",
        "LOG_LEVEL": "debug",
        "ANALYTICS_ENABLED": "false"
      }
    }
  }
}