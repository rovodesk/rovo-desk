APP_ENV=development
SERVICE_NAME=auth-service
SERVICE_VERSION=v1
ADDR=:5001

COGNITO_REGION=ap-south-1
COGNITO_CLIENT_ID=xxxxx
COGNITO_CLIENT_SECRET=xxxxx
COGNITO_CALLBACK_URL=http://localhost:5001/auth/callback
COGNITO_DOMAIN=https://xxx.auth.ap-south-1.amazoncognito.com

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

SESSION_TTL=24h
SIGNUP_SESSION_TTL=10m
LOGIN_SESSION_TTL=10m

SESSION_COOKIE_NAME=__session
COOKIE_SECRET=super-secret-key

LOG_LEVEL=error
TRACKING_ENABLED=true
OTEL_COLLECTOR=localhost:4317
