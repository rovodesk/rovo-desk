# ============================================================================
# Auth Service Environment Configuration
# ============================================================================
# Copy this file to .env and fill in the values for your environment.
# For development, most values have sensible defaults.

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
# Port the server listens on
SERVER_PORT=8080

# Host to bind to (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
SERVER_HOST=0.0.0.0

# Environment: development, staging, or production
# Changes logging level, cookie security, and other defaults
SERVER_ENV=development

# ============================================================================
# SERVICE METADATA
# ============================================================================
# Service name for logging and tracing
SERVICE_NAME=auth-service

# Service version/tag
SERVICE_VERSION=v1

# ============================================================================
# AWS COGNITO CONFIGURATION
# ============================================================================
# REQUIRED for production. Get these from AWS Cognito console.

# AWS Region where Cognito User Pool is located
# Example: us-east-1, ap-south-1, eu-west-1
COGNITO_REGION=ap-south-1

# Cognito App Client ID
# Get from: Cognito User Pool > App Integration > App Clients
COGNITO_CLIENT_ID=xxxxx

# Cognito App Client Secret
# Get from: Cognito User Pool > App Integration > App Clients
COGNITO_CLIENT_SECRET=xxxxx

# Cognito User Pool ID
# Format: region_randomstring (e.g., ap-south-1_ZP7iLLMnN)
# Get from: Cognito User Pools > General Settings > Pool ID
COGNITO_USER_POOL_ID=ap-south-1_xxxxx

# Cognito Domain (custom domain or Cognito domain)
# Custom domain: https://your-domain.auth.region.amazoncognito.com
# Cognito domain: https://your-user-pool.auth.region.amazoncognito.com
COGNITO_DOMAIN=https://your-domain.auth.ap-south-1.amazoncognito.com

# OAuth/OIDC redirect URI after successful authentication
# Must be registered in Cognito App Client settings
COGNITO_REDIRECT_URI=http://localhost:8080/auth/callback

# ============================================================================
# COOKIE CONFIGURATION
# ============================================================================
# Security settings for authentication cookies

# Secret key for signing cookies (HMAC-SHA256)
# MUST be at least 32 characters in production
# Generate with: openssl rand -base64 32
COOKIE_SECRET=super-secret-key-min-32-chars-for-dev

# Domain for which the cookie is valid
# .localhost matches localhost, .example.com matches *.example.com
COOKIE_DOMAIN=.localhost

# URL path scope for cookie (/ for all paths)
COOKIE_PATH=/

# Cookie expiration time in seconds
# Default: 604800 (7 days)
# Set to 0 for session-only cookies (deleted on browser close)
COOKIE_MAX_AGE=604800

# Secure flag - cookie only sent over HTTPS
# Set to true in production
COOKIE_SECURE=false

# HttpOnly flag - cookie not accessible from JavaScript
# Should always be true for security
COOKIE_HTTP_ONLY=true

# SameSite attribute: Strict, Lax, or None
# Lax is recommended balance of security and usability
COOKIE_SAME_SITE=Lax

# Session cookie name
SESSION_COOKIE_NAME=__session

# ============================================================================
# REDIS/CACHE CONFIGURATION
# ============================================================================
# Redis for session storage, rate limiting, and caching

# Redis server address (host:port)
# For Docker: redis:6379
# For localhost: localhost:6379
REDIS_ADDR=localhost:6379

# Redis password (leave empty if no password)
REDIS_PASSWORD=

# Redis database number (0-15)
REDIS_DB=0

# Key prefix for all Redis keys
# Helps when sharing Redis instance across services
REDIS_PREFIX=auth-service

# Redis TTL for general cache (time to live)
REDIS_TTL=24h

# ============================================================================
# SESSION CONFIGURATION
# ============================================================================
# Session expiration times

# General session TTL
SESSION_TTL=24h

# Signup/registration session TTL (temporary)
SIGNUP_SESSION_TTL=10m

# Login session TTL (temporary, for OTP verification)
LOGIN_SESSION_TTL=10m

# ============================================================================
# RATE LIMITING
# ============================================================================
# Protection against abuse and brute-force attacks

# Enable rate limiting globally
RATE_LIMIT_ENABLED=true

# Max requests per window
RATE_LIMIT_REQUESTS=100

# Rate limit window in seconds
RATE_LIMIT_WINDOW_SECONDS=60

# Max OTP verification attempts before lockout
OTP_RATE_LIMIT_ATTEMPTS=5

# OTP rate limit window in minutes
# After 5 failed attempts within 5 minutes, user is locked out
OTP_RATE_LIMIT_WINDOW_MINUTES=5

# Resend code rate limit window in minutes
# Prevents flooding (max 1 resend per minute)
RESEND_RATE_LIMIT_WINDOW_MINUTES=1

# ============================================================================
# LOGGING & OBSERVABILITY
# ============================================================================
# Logging levels and tracing configuration

# Log level: debug, info, warn, error, fatal
# debug: Very verbose, all operations
# info: Normal operations and important events
# warn: Warning messages and errors
# error: Errors only
LOG_LEVEL=info

# Log format: json or text
# json: Structured logging for aggregation
# text: Human-readable logs
LOG_FORMAT=json

# Enable OpenTelemetry tracing
# Set to true to send traces to OTEL_COLLECTOR
TRACING_ENABLED=false

# OpenTelemetry collector address (gRPC)
OTEL_COLLECTOR=localhost:4317

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Cross-Origin Resource Sharing settings

# Enable CORS headers
CORS_ENABLED=true

# Comma-separated list of allowed origins
# In production, be specific: https://yourdomain.com,https://app.yourdomain.com
# Security: Avoid using wildcard * in production
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Allowed HTTP methods
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS

# Allowed request headers
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# CORS max age in seconds (how long to cache preflight)
CORS_MAX_AGE=3600

# ============================================================================
# ENVIRONMENT-SPECIFIC RECOMMENDATIONS
# ============================================================================

# DEVELOPMENT (.env file)
# - SERVER_ENV=development
# - COOKIE_SECURE=false
# - LOG_LEVEL=debug
# - CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# STAGING (use secrets management)
# - SERVER_ENV=staging
# - COOKIE_SECURE=true (over HTTPS)
# - LOG_LEVEL=info
# - All credentials from AWS Secrets Manager or similar

# PRODUCTION (use secrets management)
# - SERVER_ENV=production
# - COOKIE_SECURE=true (HTTPS required)
# - LOG_LEVEL=warn
# - CORS_ALLOWED_ORIGINS=https://yourdomain.com only
# - All credentials from AWS Secrets Manager or HashiCorp Vault
# - COOKIE_SECRET: strong random 32+ char value
# - Rate limiting: adjusted based on your traffic
