    "infra:down": "docker-compose down",
    "test": "vitest run",
    "make-badges": "bun run istanbul-badges-readme --coverageDir='./coverage'",
    "test:gui": "vitest --ui",
    "test:coverage": "vitest run --coverage && bun run make-badges"
