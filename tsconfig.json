{
  "extends": "@zero-heads-lab/typescript-config/base.json",
  "compilerOptions": {
    "noEmit": true,
    "strictNullChecks": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "paths": {
      "@zero-heads-lab/*": ["./*"]
    },
    "types": ["@cloudflare/workers-types"]
  },
  "include": [
    "drizzle.config.ts",
    "**/*.ts",
    "**/*.tsx",
    "apps/widget/src/embed.js"
  ],
  "exclude": ["node_modules", "dist"]
}
