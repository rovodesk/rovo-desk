{
  "extends": "@zero-heads-lab/typescript-config/base.json",
  "compilerOptions": {
    "noEmit": true,
    "strictNullChecks": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "paths": {
      "@zero-heads-lab/*": ["./packages/*"]
    },
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
