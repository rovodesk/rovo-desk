{
  "extends": "@zero-heads-lab/typescript-config/base.json",
  "compilerOptions": {
    "noEmit": true,
    "strictNullChecks": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "paths": {
      "@zero-heads-lab/*": ["./*"]
    },
    "types": ["@cloudflare/workers-types"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "frontend/dashboard/src/lib/auth/guards.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
